# Sample only. Copy to ~/.config/containers/systemd/openpak-np-uploader.container.
[Unit]
Description=OpenPak np-uploader

[Container]
ContainerName=openpak-np-uploader
Image=ghcr.io/openpak/np-uploader:latest
Network=openpak
EnvironmentFile=%h/openpak/deploy/np-uploader.env
Environment=NP_HTTP_ADDR=:8535
Volume=%h/openpak/deploy/ps3-keys:/run/ps3:ro

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
